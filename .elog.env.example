# Copy this file to .elog.env. Keep credentials on your computer.
# token: use an existing Yuque Token; password: use your Yuque account password.
YUQUE_AUTH=token

# https://www.yuque.com/your-login/your-repo/document-slug
YUQUE_LOGIN=
YUQUE_REPO=

YUQUE_TOKEN=
YUQUE_USERNAME=
YUQUE_PASSWORD=

# Default: sync only public, published documents.
# Set false only for a dedicated blog knowledge base whose contents you intend to publish.
YUQUE_ONLY_PUBLIC=true

# Personal accounts normally do not need to change this.
YUQUE_HOST=https://www.yuque.com
