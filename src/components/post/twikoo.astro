---
import { url } from "@utils/url";
import { postConfig } from "@/config";


interface Props {
    path: string;
}

const config = {
    ...postConfig.comment.twikoo,
    el: "#tcomment",
    path: Astro.props.path,
};
---

<div id="tcomment"
    data-twikoo-config={JSON.stringify(config)}
    data-twikoo-script={url("/assets/js/twikoo-2.0.17.min.js")}
></div>
<link rel="stylesheet" href={url("/assets/css/twikoo.css")} />
<script>
    import { initComments } from "@/plugins/comments";
    initComments();
</script>
