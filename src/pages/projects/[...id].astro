---
import MarkdownIt from "markdown-it";
import { projectsData, type Project } from "@utils/projects";
import GridLayout from "@layouts/grid.astro";
import Markdown from "@components/common/markdown.astro";
import BackwardButton from "@components/backwardButton.astro";
import { i18n } from "@i18n/translation";
import I18nKey from "@i18n/i18nKey";

export const prerender = true;
export function getStaticPaths() {
    return projectsData.filter(project => project.details?.trim()).map(project => ({
        params: { id: project.id }, props: { project },
    }));
}
interface Props { project: Project; }
const { project } = Astro.props;
const html = new MarkdownIt().render(project.details || "");
---

<GridLayout title={project.title} description={project.description}>
    <article class="card-base w-full px-6 py-6 md:px-9">
        <BackwardButton href="/projects/" text={i18n(I18nKey.projects)} />
        <h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-6">{project.title}</h1>
        <Markdown class="project-details">
            <div set:html={html} />
        </Markdown>
    </article>
</GridLayout>
